    choose_title: 'KiKi Models — language / Язык',
    choose_prompt: 'Select interface language / Выберите язык:',
    choose_accept: 'Save / Сохранить',
    choose_cancel: 'Cancel / Отмена',
    lang_saved: 'KiKi Models language: English. Preference saved.',
    lang_file_error: 'Could not save the language preference to user settings.'
  }
};
function kikiLanguageFile() {
  if (typeof Folder === 'undefined' || typeof File === 'undefined') return null;
  var home = new Folder(Folder.userData.fsName + '/KiKiModels');
  return {home:home, file:new File(home.fsName + '/language.txt')};
}
function kikiGetLanguage() {
  if (kikiLangCache === 'ru' || kikiLangCache === 'en') return kikiLangCache;
  try {
    var cfg=kikiLanguageFile();
    if (cfg !== null && cfg.file.exists) {
      cfg.file.encoding='UTF-8';
      if (!cfg.file.open('r')) return 'ru';
      var val=String(cfg.file.read()).replace(/\s+/g,'').toLowerCase();
      cfg.file.close();
      if (val==='ru' || val==='en') { kikiLangCache=val; return val; }
    }
  } catch(ex) {}
  return 'ru';
}
function kikiSetLanguage(lang) {
  if (lang!=='ru' && lang!=='en') throw Error('Language must be ru or en');
  var cfg=kikiLanguageFile();
  if (cfg===null) throw Error('File/Folder API is unavailable');
  if (!cfg.home.exists && !cfg.home.create()) throw Error('Cannot create settings directory');
  cfg.file.encoding='UTF-8';
  if (!cfg.file.open('w')) throw Error('Cannot write language preference');
  cfg.file.write(lang); cfg.file.close(); kikiLangCache=lang;
}
function kikiT(key,params) {
  var lang=kikiGetLanguage();
  var table=KIKI_STRINGS[lang] || KIKI_STRINGS.ru;
  var msg=table[key] || KIKI_STRINGS.en[key] || key;
  return msg.replace(/\{([a-z_]+)\}/g,function(all,name){
    return params && params[name] !== undefined ? String(params[name]) : all;
  });
}
